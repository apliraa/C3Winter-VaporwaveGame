theme_override_colors/default_color = Color(0.27447626, 5.121112e-05, 0.27488896, 1)
theme_override_fonts/normal_font = ExtResource("6_o33ma")
theme_override_fonts/bold_font = ExtResource("6_o33ma")
theme_override_fonts/bold_italics_font = ExtResource("6_o33ma")
